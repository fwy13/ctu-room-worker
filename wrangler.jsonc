{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ctu-room-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "triggers": {
    "crons": ["0 22 13 10 *"],
  },
  "kv_namespaces": [
    {
      "binding": "BOOKINGS",
      "id": "ID_OF_YOUR_KV_NAMESPACE",
      "remote": true,
    },
  ],
}
